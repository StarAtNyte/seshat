[Desktop Entry]
Type=Application
Name=Seshat
GenericName=Ebook Reader
Comment=Read EPUB, MOBI, AZW3, FB2, PDF, CBZ and TXT books
Exec=seshat %f
Icon=seshat
Terminal=false
Categories=Office;Viewer;Literature;
MimeType=application/epub+zip;application/x-mobipocket-ebook;application/vnd.amazon.ebook;application/x-fictionbook+xml;application/pdf;application/vnd.comicbook+zip;text/plain;
Keywords=ebook;reader;epub;mobi;pdf;library;
StartupWMClass=seshat
